// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  yandexId      String         @id @unique
  username      String
  yandexToken   String
  tasks         Task[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [yandexId])
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum TaskStatus {
  PENDING
  COMPLETED
  FAILED
}

model Task {
  id      Int        @id @default(autoincrement())
  status  TaskStatus
  user    User       @relation(fields: [userId], references: [yandexId])
  userId  String
  phrases Phrase[]
}

model Phrase {
  id         Int          @id @default(autoincrement())
  title      String
  task       Task         @relation(fields: [taskId], references: [id])
  taskId     Int
  phaseStats PhraseStat[]

  @@unique([taskId, title])
}

model PhraseStat {
  id      Int    @id @default(autoincrement())
  date    String
  count   Int
  phase   Phrase @relation(fields: [phaseId], references: [id])
  phaseId Int
}
